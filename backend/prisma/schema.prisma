generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auditoria {
  id            Int      @id @default(autoincrement())
  tabla         String
  registro_id   Int
  usuario_id    Int?
  operacion     String
  datos_previos Json?
  datos_nuevos  Json?
  fecha         DateTime @default(now()) @db.Timestamptz(6)
  usuario       usuario? @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id])
  @@index([fecha])
  @@index([tabla, registro_id])
}

model bitacorabusquedavh {
  id            Int      @id @default(autoincrement())
  usuario_id    Int
  placa         String   @db.VarChar(10)
  tipo_busqueda String?
  precio        Decimal? @db.Decimal
  respuesta_api Json?
  buscada_el    DateTime @default(now()) @db.Timestamptz(6)
  usuario       usuario  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([usuario_id])
  @@index([placa])
  @@index([buscada_el])
  @@index([usuario_id, buscada_el])
}

model cita {
  id                               Int      @id @default(autoincrement())
  cliente_id                       Int
  abogado_id                       Int
  consulta_id                      Int
  pago_id                          Int?
  inicia_el                        DateTime @db.Timestamptz(6)
  termina_el                       DateTime @db.Timestamptz(6)
  estado                           est_cita @default(pendiente)
  actualizado_el                   DateTime @updatedAt @db.Timestamptz(6)
  usuario_cita_abogado_idTousuario usuario  @relation("cita_abogado_idTousuario", fields: [abogado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario_cita_cliente_idTousuario usuario  @relation("cita_cliente_idTousuario", fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consulta                         consulta @relation(fields: [consulta_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pago                             pago?    @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resena                           resena?

  @@index([cliente_id])
  @@index([abogado_id])
  @@index([consulta_id])
  @@index([pago_id])
  @@index([estado])
  @@index([inicia_el])
  @@index([termina_el])
  @@index([abogado_id, inicia_el])
}

model resena {
  id             Int      @id @default(autoincrement())
  cita_id        Int      @unique
  rating         Int
  comentario     String?
  creado_el      DateTime @default(now()) @db.Timestamptz(6)
  actualizado_el DateTime @updatedAt @db.Timestamptz(6)
  cita           cita     @relation(fields: [cita_id], references: [id], onDelete: Cascade)

  @@index([creado_el])
}

model clienteabogado {
  id                                         Int      @id @default(autoincrement())
  abogado_id                                 Int
  cliente_id                                 Int
  creado_el                                  DateTime @default(now()) @db.Timestamptz(6)
  notas_privadas                             String?
  usuario_clienteabogado_abogado_idTousuario usuario  @relation("clienteabogado_abogado_idTousuario", fields: [abogado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario_clienteabogado_cliente_idTousuario usuario  @relation("clienteabogado_cliente_idTousuario", fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([abogado_id, cliente_id])
  @@index([creado_el])
}

model consulta {
  id                                   Int            @id @default(autoincrement())
  cliente_id                           Int
  abogado_id                           Int
  pregunta                             String
  especialidad_id                      Int?
  tipo                                 tipo_consulta  @default(texto)
  audio_url                            String?
  opcion_respuesta                     resp_consulta?
  documento_id                         Int?
  pago_id                              Int?
  estado                               est_consulta   @default(pendiente)
  creada_el                            DateTime       @default(now()) @db.Timestamptz(6)
  actualizado_el                       DateTime       @updatedAt @db.Timestamptz(6)
  cita                                 cita[]
  usuario_consulta_abogado_idTousuario usuario        @relation("consulta_abogado_idTousuario", fields: [abogado_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario_consulta_cliente_idTousuario usuario        @relation("consulta_cliente_idTousuario", fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documento                            documento?     @relation(fields: [documento_id], references: [id], onUpdate: NoAction)
  especialidad                         especialidad?  @relation(fields: [especialidad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pago                                 pago?          @relation(fields: [pago_id], references: [id], onUpdate: NoAction)

  @@index([cliente_id])
  @@index([abogado_id])
  @@index([especialidad_id])
  @@index([pago_id])
  @@index([estado])
  @@index([creada_el])
  @@index([tipo])
}

model documento {
  id                                        Int             @id @default(autoincrement())
  propietario_id                            Int
  tipo_documento                            String?
  ruta_archivo                              String
  generado_ai                               Boolean         @default(false)
  firmado                                   Boolean         @default(false)
  firma_url                                 String?
  abogado_firma                             Int?
  formato_id                                Int?
  institucion                               String?
  enviado                                   Boolean         @default(false)
  estado_tramite                            est_doc_tramite @default(pendiente)
  enviado_el                                DateTime?       @db.Timestamptz(6)
  pago_id                                   Int?
  tamano                                    Int?
  creado_el                                 DateTime        @default(now()) @db.Timestamptz(6)
  actualizado_el                            DateTime        @updatedAt @db.Timestamptz(6)
  consulta                                  consulta[]
  usuario_documento_abogado_firmaTousuario  usuario?        @relation("documento_abogado_firmaTousuario", fields: [abogado_firma], references: [id], onDelete: NoAction, onUpdate: NoAction)
  formato                                   formato?        @relation(fields: [formato_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pago                                      pago?           @relation(fields: [pago_id], references: [id], onUpdate: NoAction)
  usuario_documento_propietario_idTousuario usuario         @relation("documento_propietario_idTousuario", fields: [propietario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([propietario_id])
  @@index([pago_id])
  @@index([abogado_firma])
  @@index([estado_tramite])
  @@index([creado_el])
}

model archivo {
  id                  Int                   @id @default(autoincrement())
  usuario_id          Int
  ruta                String
  tamano              Int
  tipo                String?
  creado_el           DateTime              @default(now()) @db.Timestamptz(6)
  usuario             usuario               @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  colegiaturaabogado  colegiaturaabogado[]
  pago_voucher        pago?                 @relation("PagoVoucher")
  perfilabogado       perfilabogado[]
  verificacionabogado verificacionabogado[]

  @@index([usuario_id])
  @@index([creado_el])
}

model estadopago {
  id     Int    @id @default(autoincrement()) @db.SmallInt
  codigo String @unique
  nombre String
  pago   pago[]
}

model pago {
  id                 Int           @id @default(autoincrement())
  usuario_id         Int
  monto              Decimal       @db.Decimal
  moneda             String        @db.Char(3)
  concepto           String?
  proveedor_txn      String?
  referencia         String?       @unique
  voucher_archivo_id Int?          @unique
  estado_id          Int           @db.SmallInt
  metodo_pago        String?
  servicio_id        Int?
  plan_id            Int?
  creado_el          DateTime      @default(now()) @db.Timestamptz(6)
  actualizado_el     DateTime      @updatedAt @db.Timestamptz(6)
  cita               cita[]
  consultas          consulta[]
  documentos         documento[]
  estadopago         estadopago    @relation(fields: [estado_id], references: [id])
  plan               plan?         @relation(fields: [plan_id], references: [id])
  servicio           servicio?     @relation(fields: [servicio_id], references: [id])
  usuario            usuario       @relation(fields: [usuario_id], references: [id])
  voucher            archivo?      @relation("PagoVoucher", fields: [voucher_archivo_id], references: [id])
  pagodetalle        pagodetalle[]

  @@index([estado_id])
  @@index([usuario_id])
  @@index([creado_el])
  @@index([metodo_pago])
  @@index([plan_id])
  @@index([servicio_id])
}

model pagodetalle {
  id      Int               @id @default(autoincrement())
  pago_id Int
  tipo    tipo_detalle_pago
  monto   Decimal           @db.Decimal
  pago    pago              @relation(fields: [pago_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([pago_id, tipo])
  @@index([pago_id])
}

model tarifa {
  id               Int              @id @default(autoincrement())
  descripcion      String?
  valor            Decimal          @db.Decimal
  incluye_impuesto Boolean          @default(false)
  tipo_calculo     tipo_calculo_tc?
  parametros       Json?
  activo           Boolean          @default(true)
  vigencia_desde   DateTime?        @db.Timestamptz(6)
  vigencia_hasta   DateTime?        @db.Timestamptz(6)
  servicio_id      Int?
  plan_id          Int?
  creado_el        DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_el   DateTime         @updatedAt @db.Timestamptz(6)
  plan             plan?            @relation("PlanTarifa", fields: [plan_id], references: [id])
  servicio         servicio?        @relation("ServicioTarifa", fields: [servicio_id], references: [id])

  @@index([servicio_id])
  @@index([plan_id])
  @@index([vigencia_desde, vigencia_hasta])
}

model comision {
  id             Int           @id @default(autoincrement())
  descripcion    String?
  rol_aplica     rol_aplica_tc
  porcentaje     Decimal       @db.Decimal
  activo         Boolean       @default(true)
  vigencia_desde DateTime?     @db.Timestamptz(6)
  vigencia_hasta DateTime?     @db.Timestamptz(6)
  servicio_id    Int?
  plan_id        Int?
  creado_el      DateTime      @default(now()) @db.Timestamptz(6)
  actualizado_el DateTime      @updatedAt @db.Timestamptz(6)
  plan           plan?         @relation("PlanComision", fields: [plan_id], references: [id])
  servicio       servicio?     @relation("ServicioComision", fields: [servicio_id], references: [id])

  @@index([servicio_id])
  @@index([plan_id])
  @@index([rol_aplica])
  @@index([vigencia_desde, vigencia_hasta])
}

model impuesto {
  id             Int       @id @default(autoincrement())
  codigo         String    @unique
  nombre         String
  porcentaje     Decimal   @db.Decimal
  activo         Boolean   @default(true)
  vigencia_desde DateTime? @db.Timestamptz(6)
  vigencia_hasta DateTime? @db.Timestamptz(6)
  creado_el      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([activo])
  @@index([vigencia_desde, vigencia_hasta])
}

model econconfig {
  id             Int            @id @default(autoincrement())
  moneda_defecto String         @db.Char(3)
  regla_redondeo regla_redondeo @default(dos_decimales)
  decimales      Int            @default(2)
  activo         Boolean        @default(true)
  actualizado_el DateTime       @updatedAt @db.Timestamptz(6)
}

model verificacionabogado {
  id                Int                 @id @default(autoincrement())
  persona_id        Int                 @unique
  /// //////////////////////////////////////////////////////
  linkedin_url      String?
  titulo_archivo_id Int?
  estado            EstadoVerificacion  @default(PENDIENTE)
  observaciones     String?
  aprobado_el       DateTime?
  /// //////////////////////////////////////////////////////
  creado_el         DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_el    DateTime            @updatedAt @db.Timestamptz(6)
  colegiatura_id    Int?
  colegiatura       colegiaturaabogado? @relation(fields: [colegiatura_id], references: [id])
  persona           persona             @relation(fields: [persona_id], references: [id], onDelete: Cascade)
  titulo            archivo?            @relation(fields: [titulo_archivo_id], references: [id])

  @@index([colegiatura_id])
  @@index([estado])
}

model colegioabogado {
  id             Int                  @id @default(autoincrement())
  region         String?
  nombre         String
  creado_el      DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_el DateTime             @updatedAt @db.Timestamptz(6)
  colegiaturas   colegiaturaabogado[]

  @@unique([nombre, region])
  @@index([region])
}

model colegiaturaabogado {
  id                   Int                   @id @default(autoincrement())
  persona_id           Int                   @unique
  colegio_id           Int
  carnet_archivo_id    Int?
  /// //////////////////////////////////////////////////////
  numero               String                @db.VarChar(30)
  fecha_emision        DateTime?             @db.Timestamptz(6)
  fecha_vigencia_hasta DateTime?             @db.Timestamptz(6)
  creado_el            DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_el       DateTime              @updatedAt @db.Timestamptz(6)
  carnet_archivo       archivo?              @relation(fields: [carnet_archivo_id], references: [id])
  colegio              colegioabogado        @relation(fields: [colegio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  persona              persona               @relation(fields: [persona_id], references: [id], onDelete: Cascade)
  verificacionabogado  verificacionabogado[]

  @@unique([colegio_id, numero])
  @@unique([id, persona_id])
  @@index([colegio_id])
}

model recuperacionclave {
  id             Int                     @id @default(autoincrement())
  persona_id     Int
  usuario_id     Int
  /// //////////////////////////////////////////////////////
  codigo         String
  expiracion     DateTime                @db.Timestamptz(6)
  estado         EstadoRecuperacionClave @default(PENDIENTE)
  intentos       Int                     @default(0)
  creado_el      DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_el DateTime                @updatedAt @db.Timestamptz(6)
  persona        persona                 @relation(fields: [persona_id], references: [id], onDelete: Cascade)
  usuario        usuario                 @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([persona_id])
  @@index([usuario_id])
  @@index([usuario_id, estado, expiracion], map: "recuperacionclave_by_user_status_exp_idx")
  @@map("recuperacionclave")
}

model persona {
  id                     Int                  @id @default(autoincrement())
  dni                    String               @unique @db.Char(8)
  telefono               String?              @unique @db.VarChar(15)
  primer_nombre          String               @db.VarChar(100)
  segundo_nombre         String?              @db.VarChar(100)
  apellido_paterno       String               @db.VarChar(100)
  apellido_materno       String?              @db.VarChar(100)
  correo                 String               @unique
  direccion_id           String?              @db.Char(6)
  linea_exacta_direccion String?
  colegiatura            colegiaturaabogado?
  direccion              direccion?           @relation(fields: [direccion_id], references: [ubigeo_codigo])
  recuperaciones_clave   recuperacionclave[]
  usuario                usuario[]
  verificacionabogado    verificacionabogado?

  @@index([apellido_paterno])
  @@index([correo])
}

model direccion {
  ubigeo_codigo String    @id @db.Char(6)
  departamento  String
  provincia     String
  distrito      String
  estudio       estudio[]
  persona       persona[]

  @@index([ubigeo_codigo])
  @@index([departamento, provincia, distrito])
}

model role {
  id      Int       @id @default(autoincrement()) @db.SmallInt
  codigo  String    @unique
  nombre  String
  usuario usuario[]
}

model usuario {
  id                                                Int                  @id @default(autoincrement())
  persona_id                                        Int
  clave                                             String
  telefono_verificado                               Boolean              @default(false)
  plan_id                                           Int?
  almacenamiento_usado                              Int                  @default(0)
  creado_el                                         DateTime             @default(now()) @db.Timestamptz(6)
  activo                                            Boolean              @default(false)
  role_id                                           Int                  @db.SmallInt
  abogadoestudios                                   abogadoestudio[]     @relation("UsuarioAbogadoEstudio")
  archivos                                          archivo[]
  auditoria                                         auditoria[]
  bitacorabusquedavh                                bitacorabusquedavh[]
  cita_cita_abogado_idTousuario                     cita[]               @relation("cita_abogado_idTousuario")
  cita_cita_cliente_idTousuario                     cita[]               @relation("cita_cliente_idTousuario")
  clienteabogado_clienteabogado_abogado_idTousuario clienteabogado[]     @relation("clienteabogado_abogado_idTousuario")
  clienteabogado_clienteabogado_cliente_idTousuario clienteabogado[]     @relation("clienteabogado_cliente_idTousuario")
  consulta_consulta_abogado_idTousuario             consulta[]           @relation("consulta_abogado_idTousuario")
  consulta_consulta_cliente_idTousuario             consulta[]           @relation("consulta_cliente_idTousuario")
  documento_documento_abogado_firmaTousuario        documento[]          @relation("documento_abogado_firmaTousuario")
  documento_documento_propietario_idTousuario       documento[]          @relation("documento_propietario_idTousuario")
  pago                                              pago[]
  perfilabogado                                     perfilabogado?
  recuperaciones_clave                              recuperacionclave[]
  persona                                           persona              @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan                                              plan?                @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role                                              role                 @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([persona_id, role_id])
  @@index([persona_id])
  @@index([role_id])
  @@index([plan_id])
  @@index([creado_el])
  @@index([activo])
}

model disponibilidadabogado {
  id            Int           @id @default(autoincrement())
  abogado_id    Int
  dia_semana    Int           @db.SmallInt
  hora_inicio   DateTime      @db.Time(6)
  hora_fin      DateTime      @db.Time(6)
  perfilabogado perfilabogado @relation(fields: [abogado_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([abogado_id, dia_semana, hora_inicio, hora_fin])
  @@index([abogado_id, dia_semana])
}

model perfilabogado_especialidad {
  id               Int           @id @default(autoincrement())
  perfilabogado_id Int
  especialidad_id  Int
  especialidad     especialidad  @relation("EspecialidadPerfiles", fields: [especialidad_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  perfilabogado    perfilabogado @relation("PerfilEspecialidades", fields: [perfilabogado_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([perfilabogado_id, especialidad_id])
  @@index([perfilabogado_id])
  @@index([especialidad_id])
}

model especialidad {
  id                    Int                          @id @default(autoincrement())
  nombre                String                       @unique
  consulta              consulta[]
  formatos              formato[]
  perfiles_especialidad perfilabogado_especialidad[] @relation("EspecialidadPerfiles")
}

model estudio {
  id                               Int              @id @default(autoincrement())
  /// //////////////////////
  ruc                              String           @unique
  nombre_comercial                 String?
  nombre_o_razon_social            String?
  /// //////////////////////
  correo_contacto                  String?
  telefono                         String?
  direccion_id                     String?          @db.Char(6)
  direccion_exacta                 String?
  linea_exacta_direccion           String?
  estado                           String?
  condicion                        String?
  /// ////////////////////// Flags SUNAT
  es_agente_retencion              Boolean?         @default(false)
  es_agente_percepcion             Boolean?         @default(false)
  es_agente_percepcion_combustible Boolean?         @default(false)
  es_buen_contribuyente            Boolean?         @default(false)
  /// //////////////////////
  activo                           Boolean          @default(false)
  creado_el                        DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_el                   DateTime         @updatedAt @db.Timestamptz(6)
  abogadoestudios                  abogadoestudio[] @relation("EstudioAbogadoEstudio")
  direccion                        direccion?       @relation(fields: [direccion_id], references: [ubigeo_codigo])

  @@index([estado])
  @@index([condicion])
}

model abogadoestudio {
  id             Int      @id @default(autoincrement())
  usuario_id     Int
  estudio_id     Int
  principal      Boolean  @default(false)
  rol_en_estudio String?
  activo         Boolean  @default(true)
  creado_el      DateTime @default(now()) @db.Timestamptz(6)
  actualizado_el DateTime @updatedAt @db.Timestamptz(6)
  estudio        estudio  @relation("EstudioAbogadoEstudio", fields: [estudio_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario  @relation("UsuarioAbogadoEstudio", fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([usuario_id, estudio_id])
  @@index([activo])
  @@index([usuario_id])
  @@index([estudio_id])
}

model perfilabogado {
  usuario_id            Int                          @id
  /// //////////////////////////////////////////////////////
  avatar_archivo_id     Int?
  tarifa_base           Decimal?                     @db.Decimal
  direccion_atencion    String?
  bio                   String?
  /// //////////////////////////////////////////////////////
  rating_promedio       Decimal?                     @db.Decimal
  rating_cantidad       Int                          @default(0)
  place_id_api          String?
  creado_el             DateTime                     @default(now()) @db.Timestamptz(6)
  actualizado_el        DateTime                     @updatedAt @db.Timestamptz(6)
  disponibilidadabogado disponibilidadabogado[]
  avatar                archivo?                     @relation(fields: [avatar_archivo_id], references: [id])
  usuario               usuario                      @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  especialidades        perfilabogado_especialidad[] @relation("PerfilEspecialidades")
}

model plan {
  id                    Int            @id @default(autoincrement())
  nombre                String
  almacenamiento_maximo Int?
  actualizado_el        DateTime       @updatedAt @db.Timestamptz(6)
  comisiones            comision[]     @relation("PlanComision")
  pago                  pago[]
  planservicio          planservicio[]
  tarifas               tarifa[]       @relation("PlanTarifa")
  usuarios              usuario[]

  @@index([nombre])
}

model servicio {
  id               Int            @id @default(autoincrement())
  codigo           String         @unique
  nombre           String
  descripcion      String?
  activo           Boolean        @default(true)
  fecha_creada     DateTime       @default(now()) @db.Timestamptz(6)
  fecha_modificada DateTime       @updatedAt @db.Timestamptz(6)
  comisiones       comision[]     @relation("ServicioComision")
  pago             pago[]
  planservicios    planservicio[]
  tarifas          tarifa[]       @relation("ServicioTarifa")

  @@index([activo])
  @@index([codigo])
}

model planservicio {
  id             Int       @id @default(autoincrement())
  servicio_id    Int
  plan_id        Int
  activo         Boolean   @default(true)
  vigencia_desde DateTime? @db.Timestamptz(6)
  vigencia_hasta DateTime? @db.Timestamptz(6)
  plan           plan      @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  servicio       servicio  @relation(fields: [servicio_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([plan_id, servicio_id])
  @@index([servicio_id])
  @@index([plan_id])
  @@index([activo])
}

model formato {
  id              Int           @id @default(autoincrement())
  nombre          String
  descripcion     String?
  especialidad_id Int?
  institucion     String?
  tipo_documento  String?
  ruta_archivo    String
  es_premium      Boolean       @default(false)
  costo           Decimal?      @db.Decimal
  creado_el       DateTime      @default(now()) @db.Timestamptz(6)
  actualizado_el  DateTime      @updatedAt @db.Timestamptz(6)
  documentos      documento[]
  especialidad    especialidad? @relation(fields: [especialidad_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([especialidad_id])
  @@index([es_premium])
  @@index([institucion])
  @@index([tipo_documento])
}

model bibliotecaitem {
  id           Int      @id @default(autoincrement())
  titulo       String
  descripcion  String?
  tipo         String
  ruta_archivo String
  costo        Decimal? @db.Decimal
  creado_el    DateTime @default(now()) @db.Timestamptz(6)

  @@index([tipo])
  @@index([creado_el])
}

